# FRED API (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# 한국은행 ECOS API (https://ecos.bok.or.kr/api/)
ECOS_API_KEY=

# LS증권 OPEN API (없으면 LS증권/ls_config.txt 사용)
LS_APP_KEY=
LS_APP_SECRET_KEY=

# KRX OpenAPI (선택)
KRX_JSESSIONID=
KRX_AUTH_TOKEN=

# --- 선택: Oracle (기본은 GitHub docs/data JSON) ---
# ORACLE_MODE=off | object_storage | atp
ORACLE_MODE=off
# Object Storage
OCI_NAMESPACE=
OCI_BUCKET=
OCI_PREFIX=liquidity/
# Autonomous DB
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
